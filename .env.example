# Local and production both use PostgreSQL (Neon recommended).

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
NEON_BRANCH="production"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
BOOTSTRAP_ADMIN_EMAIL="tu-email@ejemplo.com"

# Optional real email delivery later:
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Comunidad <noreply@tudominio.com>"

# Optional production file storage (Vercel Blob):
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
