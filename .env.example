# Local and production both use PostgreSQL.

# Docker local (docker compose up -d):
DATABASE_URL="postgresql://comunidad:comunidad@localhost:5432/comunidad"

# Or Neon / hosted Postgres:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
BOOTSTRAP_ADMIN_EMAIL="tu-email@ejemplo.com"

# Optional real email delivery later:
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Comunidad <noreply@tudominio.com>"

# Optional production file storage (Vercel Blob):
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
